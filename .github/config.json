{
    "cluster": "iscx-broker-center-cluster",
    "development": {
        "serviceName": "dev-broker-center-api",
        "logGroup": "/ecs/dev-broker-center-api",
        "role": "arn:aws:iam::<account-id>:role/iscx-ecs-marketplace-execution-role",
        "cpu": "512",
        "memory": "1024",
        "environment": [],
        "secrets": [
            {
                "name": "Secret",
                "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/jwt-secret-key/dev:JWT_SECRET"
            }
        ]
    },
    "qa": {
        "serviceName": "qa-broker-center-api",
        "logGroup": "/ecs/qa-broker-center-api",
        "role": "arn:aws:iam::<account-id>:role/iscx-ecs-marketplace-execution-role",
        "cpu": "512",
        "memory": "1024",
        "environment": [],
        "secrets": [
            {
                "name": "JWT_SECRET",
                "valueFrom": "placeholder"
            }
        ]
    },
    "production": {
        "serviceName": "broker-center-api",
        "logGroup": "/ecs/broker-center-api",
        "role": "arn:aws:iam::<account-id>:role/iscx-ecs-marketplace-execution-role",
        "cpu": "512",
        "memory": "1024",
        "environment": [],
        "secrets": [
            {
                "name": "JWT_SECRET",
                "valueFrom": "placeholder"
            }
        ]
    }
}