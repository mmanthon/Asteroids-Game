{
    "containerDefinitions": [
        {
            "name": "iscx-dev-broker-center-api",
            "image": "694679581764.dkr.ecr.us-west-2.amazonaws.com/iscx-dev-broker-center-api:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "AWS_REGION",
                    "value": "us-west-2"
                },
                {
                    "name": "PORT",
                    "value": "80"
                }
            ],
            "secrets": [
                {
                    "name": "JWT_SECRET",
                    "valueFrom": "rer"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/dev-broker-center-api",
                    "awslogs-create-group": "true",
                    "awslogs-region": "us-west-2",
                    "awslogs-stream-prefix": "ecs"
                }
            },
            "systemControls": []
        }
    ],
    "family": "dev-broker-center-api",
    "taskRoleArn": "arn:aws:iam::694679581764:role/iscx-ecs-marketplace-execution-role",
    "executionRoleArn": "arn:aws:iam::694679581764:role/iscx-ecs-marketplace-execution-role",
    "networkMode": "awsvpc",
    "volumes": [],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "512",
    "memory": "1024",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    }
}