{
    "cluster": "iscx-underwriter-workbench-cluster",
    "serviceName": "underwriter-workbench-api",
    "logGroup": "/ecs/underwriter-workbench-api",
    "role": "arn:aws:iam::<account-id>:role/iscx-ecs-marketplace-execution-role",
    "cpu": "512",
    "memory": "1024",
    "environment": [
        {
            "name": "AMP_API_BASE_URL",
            "value": "https://isc.onlinemga.com/amp/api"
        },
        {
            "name": "DYNAMODB_ACCESS_CONTROL_USERS_TABLE_NAME",
            "value": "ISCxAccessControlUsers"
        },
        {
            "name": "DYNAMODB_APPLICATIONS_TABLE_NAME",
            "value": "ISCxApplications"
        },
        {
            "name": "DYNAMODB_CLAIMS_TABLE_NAME",
            "value": "ISCxClaims"
        },
        {
            "name": "DYNAMODB_NOTES_TABLE_NAME",
            "value": "ISCxNotes"
        },
        {
            "name": "DYNAMODB_TASK_TABLE_NAME",
            "value": "ISCxTasks"
        },
        {
            "name": "DYNAMODB_TASK_WS_CONNECTION_TABLE_NAME",
            "value": "ISCxTaskWSConnections"
        },
        {
            "name": "DYNAMODB_EMAIL_HISTORY_TABLE_NAME",
            "value": "ISCxEmailHistory"
        },
        {
            "name": "DYNAMODB_AUTO_DECLINATION_HISTORY_TABLE_NAME",
            "value": "ISCxAutoDeclinationHistory"
        },
        {
            "name": "DYNAMODB_PRODUCTS_TABLE_NAME",
            "value": "ISCxProducts"
        },
        {
            "name": "MVR_API_URL",
            "value": "http://iscx-mvr-api.internal/api"
        },
        {
            "name": "TRACKING_DB",
            "value": "tracking"
        },
        {
            "name": "TASK_QUEUE_URL",
            "value": "https://sqs.us-west-2.amazonaws.com/049005703416/iscx-utm-queue"
        }
    ],
    "secrets": [
        {
            "name": "AMP_API_KEY",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/prod/amp/api-key-Lsp6RD:AMP_API_KEY::"
        },
        {
            "name": "JWT_SECRET",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/jwt-secret-key/prod-ueDE2o:JWT_SECRET::"
        },
        {
            "name": "AMP_DB_USER",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/amp-db/prod-Wi0QL2:AMP_DB_USER::"
        },
        {
            "name": "AMP_DB_PW",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/amp-db/prod-Wi0QL2:AMP_DB_PW::"
        },
        {
            "name": "AMP_DB_HOST",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/amp-db/prod-Wi0QL2:AMP_DB_HOST::"
        },
        {
            "name": "AMP_DB_PORT",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/amp-db/prod-Wi0QL2:AMP_DB_PORT::"
        },
        {
            "name": "AMP_DB",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/amp-db/prod-Wi0QL2:AMP_DB::"
        }
    ]
}