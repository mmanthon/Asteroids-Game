{
    "cluster": "iscx-underwriter-workbench-cluster",
    "serviceName": "dev-underwriter-workbench-api",
    "logGroup": "/ecs/dev-underwriter-workbench-api",
    "role": "arn:aws:iam::<account-id>:role/iscx-ecs-marketplace-execution-role",
    "cpu": "512",
    "memory": "1024",
    "environment": [
        {
            "name": "AMP_API_BASE_URL",
            "value": "https://dev.isceng.net/amp/api"
        },
        {
            "name": "DYNAMODB_ACCESS_CONTROL_USERS_TABLE_NAME",
            "value": "ISCxDevAccessControlUsers"
        },
        {
            "name": "DYNAMODB_APPLICATIONS_TABLE_NAME",
            "value": "ISCxDevApplications"
        },
        {
            "name": "DYNAMODB_CLAIMS_TABLE_NAME",
            "value": "ISCxDevClaims"
        },
        {
            "name": "DYNAMODB_NOTES_TABLE_NAME",
            "value": "ISCxDevNotes"
        },
        {
            "name": "DYNAMODB_TASK_TABLE_NAME",
            "value": "ISCxDevTasks"
        },
        {
            "name": "DYNAMODB_TASK_WS_CONNECTION_TABLE_NAME",
            "value": "ISCxDevTaskWSConnections"
        },
        {
            "name": "DYNAMODB_EMAIL_HISTORY_TABLE_NAME",
            "value": "ISCxDevEmailHistory"
        },
        {
            "name": "DYNAMODB_AUTO_DECLINATION_HISTORY_TABLE_NAME",
            "value": "ISCxDevAutoDeclinationHistory"
        },
        {
            "name": "DYNAMODB_PRODUCTS_TABLE_NAME",
            "value": "ISCxDevProducts"
        },
        {
            "name": "DYNAMODB_PRODUCT_VERSIONS_TABLE_NAME",
            "value": "ISCxDevProductVersions"
        },
        {
            "name": "MVR_API_URL",
            "value": "https://dev-mvr.api.isceng.net/api"
        },
        {
            "name": "TRACKING_DB",
            "value": "tracking"
        },
        {
            "name": "DYNAMODB_RISK_SUMMARIZATIONS_TABLE_NAME",
            "value": "ISCxDevRiskSummarizations"
        },
        {
            "name": "SEND_TASKS_TO_WS_FUNCTION_NAME",
            "value": "iscx-utm-send-tasks-to-ws-clients-development"
        }
    ],
    "secrets": [
        {
            "name": "AMP_API_KEY",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/dev/amp/api-key-z2Vrwd:AMP_API_KEY::"
        },
        {
            "name": "JWT_SECRET",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/jwt-secret-key/dev-biMKJU:JWT_SECRET::"
        },
        {
            "name": "AMP_DB_USER",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/amp-db/dev-9qj5Dz:AMP_DB_USER::"
        },
        {
            "name": "AMP_DB_PW",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/amp-db/dev-9qj5Dz:AMP_DB_PW::"
        },
        {
            "name": "AMP_DB_HOST",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/amp-db/dev-9qj5Dz:AMP_DB_HOST::"
        },
        {
            "name": "AMP_DB_PORT",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/amp-db/dev-9qj5Dz:AMP_DB_PORT::"
        },
        {
            "name": "AMP_DB",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/amp-db/dev-9qj5Dz:AMP_DB::"
        }
    ]
}