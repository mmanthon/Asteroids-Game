{
    "cluster": "iscx-underwriter-workbench-cluster",
    "serviceName": "qa-uwb-api",
    "logGroup": "/ecs/qa-uwb-api",
    "role": "arn:aws:iam::<account-id>:role/iscx-ecs-marketplace-execution-role",
    "cpu": "512",
    "memory": "1024",
    "environment": [
        {
            "name": "AMP_API_BASE_URL",
            "value": "https://qa.isceng.net/amp/api"
        },
        {
            "name": "DYNAMODB_ACCESS_CONTROL_USERS_TABLE_NAME",
            "value": "ISCxQAAccessControlUsers"
        },
        {
            "name": "DYNAMODB_APPLICATIONS_TABLE_NAME",
            "value": "ISCxQAApplications"
        },
        {
            "name": "DYNAMODB_CLAIMS_TABLE_NAME",
            "value": "ISCxQAClaims"
        },
        {
            "name": "DYNAMODB_NOTES_TABLE_NAME",
            "value": "ISCxQANotes"
        },
        {
            "name": "MVR_API_URL",
            "value": "https://qa-mvr.api.isceng.net/api"
        },
        {
            "name": "TRACKING_DB",
            "value": "tracking"
        }
    ],
    "secrets": [
        {
            "name": "AMP_API_KEY",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/qa/amp/api-key-wZE28y:AMP_API_KEY::"
        },
        {
            "name": "JWT_SECRET",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/jwt-secret-key/qa-09BDyN:JWT_SECRET::"
        },
        {
            "name": "AMP_DB_USER",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/amp-db/qa-yrNpFW:AMP_DB_USER::"
        },
        {
            "name": "AMP_DB_PW",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/amp-db/qa-yrNpFW:AMP_DB_PW::"
        },
        {
            "name": "AMP_DB_HOST",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/amp-db/qa-yrNpFW:AMP_DB_HOST::"
        },
        {
            "name": "AMP_DB_PORT",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/amp-db/qa-yrNpFW:AMP_DB_PORT::"
        },
        {
            "name": "AMP_DB",
            "valueFrom": "arn:aws:secretsmanager:us-west-2:<account-id>:secret:iscx/amp-db/qa-yrNpFW:AMP_DB::"
        }
    ]
}